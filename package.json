{
  "name": "forensic-report-tool",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "REQUIRE_SUPABASE_INTEGRATION=1 vitest run --maxWorkers=1 src/test/rls-isolation.test.ts src/test/credits-integration.test.ts src/test/reportDelete.integration.test.ts src/test/reportSave.integration.test.ts",
    "test:watch": "vitest",
    "check": "npm run check:custody && npm run lint && npm run typecheck && npm run test:db-runner && npm run test && npm run build",
    "lint": "eslint .",
    "check:custody": "node scripts/check-source-custody.mjs",
    "test:db-runner": "node --test scripts/disposable-db.test.mjs",
    "test:db:disposable": "node scripts/disposable-db.mjs ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.45.4",
    "docx": "^9.0.2",
    "iconv-lite": "^0.7.3",
    "mammoth": "^1.12.0",
    "next": "^15.5.21",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.15.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.2.0",
    "server-only": "^0.0.1",
    "stripe": "^17.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.21",
    "jsdom": "30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "postcss": "^8.5.18",
    "sharp": "0.35.0"
  }
}
