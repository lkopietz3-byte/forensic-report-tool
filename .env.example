# Copy to .env.local and fill in. Never commit real keys.
#
# The app runs in a keyless PREVIEW mode with no vars set (sample data, no
# Supabase/Anthropic). Each block below is validated lazily, only by the feature
# that needs it — so you can leave a block blank until you wire that feature.

# --- Site --- [public origin for canonical URLs, sitemap, robots, OG image]
# Set to the deployed domain, NO trailing slash (e.g. https://disclosed.app).
# Unset => a dev placeholder is used: fine locally, wrong for production metadata
# and for the links in your outreach. SET THIS BEFORE LAUNCH.
NEXT_PUBLIC_SITE_URL=

# --- Anthropic (Claude API) --- [server-only; powers live drafting]
# Use the API (not consumer plans) so the no-training / confidentiality terms
# apply. Unset => live drafting is disabled; preview/sample drafting still works.
# Get it: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model used for drafting. Pin an explicit dated snapshot in prod (e.g.
# claude-sonnet-4-5-20250929) so the disclosure appendix records exactly what
# produced each section; the bare alias below is fine for dev.
ANTHROPIC_DRAFT_MODEL=claude-sonnet-4-5

# --- Supabase --- [persistence + auth; unset => no persistence]
# URL + anon key are PUBLIC (shipped to the browser); RLS is what protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, RLS-BYPASS admin key. Never expose to the client, never prefix
# NEXT_PUBLIC_. If leaked, rotate immediately (see docs/RUNBOOK-SECRETS.md).
SUPABASE_SERVICE_ROLE_KEY=

# --- Health endpoint --- [optional]
# Gates the deep /api/health?deep=1 check (returns env-presence booleans only).
# Generate: openssl rand -hex 32 . Unset => deep check is disabled.
HEALTH_CHECK_TOKEN=

# --- Live-drafting kill-switch --- [optional; default OFF / fail-closed]
# Set to 1 to enable the live model-backed drafting path. Default off keeps the
# keyless preview safe with zero config. Requires ANTHROPIC_API_KEY to take effect.
NEXT_PUBLIC_FF_LIVE_DRAFTING=

# --- Billing enforcement --- [optional; default OFF / fail-open]
# Set to 1 to ENFORCE Pro entitlements on deliverable routes (Word/PDF export,
# full appendix) via checkServerAccess(). Leave OFF until Stripe is wired and a
# real subscription can exist — otherwise free users are locked out of their own
# export. The gate code path is always present and unit-tested; this just arms it.
NEXT_PUBLIC_FF_BILLING=

# --- Stripe --- [billing: checkout + webhook are wired; unset => billing off]
# Test keys from https://dashboard.stripe.com/test/apikeys .
# STRIPE_WEBHOOK_SECRET (whsec_...) comes from the webhook endpoint you point at
# /api/billing/webhook
# (use `stripe listen --forward-to localhost:3000/api/billing/webhook` in dev).
# See docs/SETUP-checklist.md for the full walk-through.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Credit packs = ONE-TIME prices. SINGLE grants 1 credit, PACK5 grants 5.
# Each export spends 1 credit when billing is enforced (the first credit per
# account is granted free). New unlimited subscriptions are intentionally not
# sold while pilot usage/support costs are being measured. Leave unset to hide
# the buy buttons.
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_PACK5=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
